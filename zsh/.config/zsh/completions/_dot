#compdef dot
# Completion for the `dot` dispatcher.
# Dynamically discovers sibling scripts by reading their '# desc:' header comment.

_dot() {
    local -a script_dirs commands
    local d f name desc

    script_dirs=("$HOME/bin/commands")
    [[ -d "$HOME/work/bin" ]] && script_dirs+=("$HOME/work/bin")

    for d in "${script_dirs[@]}"; do
        for f in "$d"/*; do
            name="${f:t}"
            [[ -x "$f" ]] || continue
            desc=$(head -5 "$f" 2>/dev/null | grep '^# desc:' | sed 's/^# desc:[[:space:]]*//')
            commands+=("$name:${desc:-No description}")
        done
    done

    _arguments -C '1: :->cmd' '*::arg:->args'

    case $state in
        cmd)
            _describe -t commands 'dot command' commands
            ;;
    esac
}

_dot "$@"
