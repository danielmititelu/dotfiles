#!/usr/bin/env bash
# desc: Extract audio from a .mov file (usage: extractAudio input.mov [output.m4a])
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: extractAudio <input.mov> [output.m4a]" >&2
  exit 1
fi

input="$1"
output="${2:-${input%.*}.m4a}"

ffmpeg -i "$input" -vn -acodec copy "$output"
